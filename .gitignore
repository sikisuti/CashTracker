# Maven
target/

# Angular / Node (frontend has its own .gitignore too, this covers root-level tooling)
frontend/node/
frontend/node_modules/
frontend/dist/
frontend/.angular/

# Generated static resources (built from frontend/, not source)
src/main/resources/static/*
!src/main/resources/static/.gitkeep

# SQLite database files
*.db
*.db-journal

# IDE
.idea/
*.iml
.vscode/
.settings/
.classpath
.project
